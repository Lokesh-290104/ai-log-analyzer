# Copy this file to .env and fill in the values. Never commit .env.

# Which LLM answers questions, in fallback order: gemini, openrouter, or both.
LLM_PROVIDER=gemini,openrouter

# Gemini API key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODELS=gemini-flash-latest

# OpenRouter (optional fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Database. Unset = SQLite file backend/local.db. Postgres URLs from hosts work as-is.
# DATABASE_URL=postgresql://user:pass@localhost:5432/logs

# Limits (0 disables a rate limit)
ASK_LIMIT_PER_MINUTE=6
ASK_LIMIT_PER_DAY=300
UPLOAD_LIMIT_PER_MINUTE=10
UPLOAD_LIMIT_PER_DAY=500
MAX_UPLOAD_BYTES=5000000
MAX_UPLOAD_LINES=100000
MAX_AGENT_STEPS=6
MAX_REPAIRS=2
LLM_TIMEOUT_MS=30000
AGENT_DEADLINE_MS=90000
# Only behind a reverse proxy (Render sets X-Forwarded-For):
TRUST_PROXY=false
